# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n’est pas versionné.

# URL du backend OpenClassrooms (dev-react-P10), joignable depuis Next.js.
# En local, c’est en général le port indiqué dans le README du backend.
API_URL_INTERNAL=http://localhost:3001

# Clé API Mistral (génération de tâches IA). Sans elle, le reste de l’app fonctionne,
# seule la génération IA renvoie une erreur 503.
MISTRAL_API_KEY=

# Optionnel. Défaut : mistral-small-latest
# MISTRAL_MODEL=mistral-small-latest
